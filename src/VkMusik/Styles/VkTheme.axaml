      <!-- Круглая/квадратная кнопка только с иконкой. -->
      <ControlTheme x:Key="VkIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource VkTextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceHover}" />
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource VkText}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceActive}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </ControlTheme>

      <!-- Та же кнопка, но подсвеченная акцентом (включённый повтор/перемешивание). -->
      <ControlTheme x:Key="VkIconButtonAccent" TargetType="Button" BasedOn="{StaticResource VkIconButton}">
        <Setter Property="Foreground" Value="{DynamicResource VkAccent}" />
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource VkAccentHover}" />
        </Style>
      </ControlTheme>

      <!-- Главная синяя кнопка ВК. -->
      <ControlTheme x:Key="VkPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource VkAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource VkOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkAccentHover}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkAccentPressed}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </ControlTheme>

      <!-- Вторичная кнопка: серая заливка, тёмный текст. -->
      <ControlTheme x:Key="VkSecondaryButton" TargetType="Button" BasedOn="{StaticResource VkPrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource VkSurfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource VkText}" />
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceActive}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceActive}" />
        </Style>
      </ControlTheme>

      <!-- Кнопка-ссылка без фона. -->
      <ControlTheme x:Key="VkLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource VkAccent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource VkAccentHover}" />
        </Style>
      </ControlTheme>

      <!-- Пункт бокового меню. -->
      <ControlTheme x:Key="VkNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource VkText}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceHover}" />
        </Style>
        <Style Selector="^.selected /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceActive}" />
        </Style>
        <Style Selector="^.selected">
          <Setter Property="Foreground" Value="{DynamicResource VkAccent}" />
        </Style>
      </ControlTheme>

      <!-- Строка трека: своя подсветка при наведении вместо стандартного выделения. -->
      <ControlTheme x:Key="VkTrackRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceHover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceHover}" />
        </Style>
      </ControlTheme>

      <!-- Кнопка совсем без оформления: нужна там, где содержимое само себе вид (обложка). -->
      <ControlTheme x:Key="VkBareButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="Transparent">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Большая круглая кнопка воспроизведения в плеере. -->
      <ControlTheme x:Key="VkPlayButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource VkAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource VkOnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkAccentHover}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkAccentPressed}" />
        </Style>
      </ControlTheme>

      <!-- Карточка плейлиста. -->
      <ControlTheme x:Key="VkCardButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource VkSurfaceHover}" />
        </Style>
      </ControlTheme>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- =============================== БАЗОВАЯ ТИПОГРАФИКА =============================== -->

  <!--
    Цвет текста задаём один раз на окне: свойство наследуемое, поэтому дочерние
    элементы подхватят его сами. Красить каждый TextBlock отдельным стилем нельзя —
    такой стиль перебил бы белый текст на синей кнопке и синий текст выбранного пункта меню.
  -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource VkBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource VkText}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource VkTextSecondary}" />
  </Style>

  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource VkTextTertiary}" />
  </Style>

  <Style Selector="TextBlock.caps">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource VkTextTertiary}" />
  </Style>

  <Style Selector="TextBox.vk">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- =============================== КНОПКИ =============================== -->


  <!--
    Состояния «включено» задаём классами, а не конвертерами: конвертер посчитал бы цвет
    один раз и не пересчитал бы его при переключении темы, а DynamicResource обновится сам.
  -->

  <Style Selector="TextBlock.trackTitle.current">
    <Setter Property="Foreground" Value="{DynamicResource VkAccent}" />
  </Style>

  <Style Selector="c|VkIcon.playerToggle">
    <Setter Property="Foreground" Value="{DynamicResource VkTextSecondary}" />
  </Style>

  <Style Selector="c|VkIcon.playerToggle.on">
    <Setter Property="Foreground" Value="{DynamicResource VkAccent}" />
  </Style>

  <Style Selector="Border.tab">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0,9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.tab.active">
    <Setter Property="Background" Value="{DynamicResource VkAccent}" />
  </Style>

  <Style Selector="Border.tab > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource VkTextSecondary}" />
  </Style>

  <Style Selector="Border.tab.active > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource VkOnAccent}" />
  </Style>

  <!-- =============================== АНИМАЦИЯ «ЭКВАЛАЙЗЕР» =============================== -->

  <Style Selector="Rectangle.eq">
    <Setter Property="Width" Value="3" />
    <Setter Property="Fill" Value="{DynamicResource VkOnAccent}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="RadiusX" Value="1.5" />
    <Setter Property="RadiusY" Value="1.5" />
  </Style>

  <Style Selector="Rectangle.eq.b1">
    <Style.Animations>
      <Animation Duration="0:0:0.62" IterationCount="INFINITE" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Height" Value="4" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Height" Value="16" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Rectangle.eq.b2">
    <Style.Animations>
      <Animation Duration="0:0:0.45" IterationCount="INFINITE" PlaybackDirection="Alternate" Delay="0:0:0.12">
        <KeyFrame Cue="0%"><Setter Property="Height" Value="14" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Height" Value="5" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Rectangle.eq.b3">
    <Style.Animations>
      <Animation Duration="0:0:0.75" IterationCount="INFINITE" PlaybackDirection="Alternate" Delay="0:0:0.05">
        <KeyFrame Cue="0%"><Setter Property="Height" Value="8" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Height" Value="17" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
