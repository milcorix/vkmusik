<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:VkMusik.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <ResourceDictionary.ThemeDictionaries>

        <!-- ============================ ТЁМНАЯ ТЕМА ВК ============================ -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="VkBackground" Color="#19191A" />
          <SolidColorBrush x:Key="VkSurface" Color="#232324" />
          <SolidColorBrush x:Key="VkSurfaceAlt" Color="#1E1E1F" />
          <SolidColorBrush x:Key="VkSurfaceHover" Color="#2C2D2E" />
          <SolidColorBrush x:Key="VkSurfaceActive" Color="#363738" />
          <SolidColorBrush x:Key="VkText" Color="#E1E3E6" />
          <SolidColorBrush x:Key="VkTextSecondary" Color="#909499" />
          <SolidColorBrush x:Key="VkTextTertiary" Color="#76787A" />
          <SolidColorBrush x:Key="VkSeparator" Color="#2E2E2F" />
          <SolidColorBrush x:Key="VkAccent" Color="#2688EB" />
          <SolidColorBrush x:Key="VkAccentHover" Color="#3C93EE" />
          <SolidColorBrush x:Key="VkAccentPressed" Color="#1E7BD6" />
          <SolidColorBrush x:Key="VkAccentSoft" Color="#22344A" />
          <SolidColorBrush x:Key="VkOnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="VkSliderTrack" Color="#3E4042" />
          <SolidColorBrush x:Key="VkOverlay" Color="#000000" Opacity="0.55" />
          <SolidColorBrush x:Key="VkDanger" Color="#E64646" />
          <SolidColorBrush x:Key="VkCoverPlaceholder" Color="#2C2D2E" />

          <!-- Поля ввода Fluent перекрашиваем через его же ключи — так надёжнее шаблонов. -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#323334" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#2C2D2E" />
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#232324" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2C2D2E" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3E4042" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2688EB" />
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2C2D2E" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#E1E3E6" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#E1E3E6" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E1E3E6" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#76787A" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#909499" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#76787A" />
          <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#2688EB" />
        </ResourceDictionary>

        <!-- ============================ СВЕТЛАЯ ТЕМА ВК ============================ -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="VkBackground" Color="#EDEEF0" />
          <SolidColorBrush x:Key="VkSurface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="VkSurfaceAlt" Color="#FFFFFF" />
          <SolidColorBrush x:Key="VkSurfaceHover" Color="#F0F2F5" />
          <SolidColorBrush x:Key="VkSurfaceActive" Color="#E5EBF1" />
          <SolidColorBrush x:Key="VkText" Color="#000000" />
          <SolidColorBrush x:Key="VkTextSecondary" Color="#818C99" />
          <SolidColorBrush x:Key="VkTextTertiary" Color="#99A2AD" />
          <SolidColorBrush x:Key="VkSeparator" Color="#E7E8EC" />
          <SolidColorBrush x:Key="VkAccent" Color="#2688EB" />
          <SolidColorBrush x:Key="VkAccentHover" Color="#3C93EE" />
          <SolidColorBrush x:Key="VkAccentPressed" Color="#1E7BD6" />
          <SolidColorBrush x:Key="VkAccentSoft" Color="#E5F0FB" />
          <SolidColorBrush x:Key="VkOnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="VkSliderTrack" Color="#D7DBE0" />
          <SolidColorBrush x:Key="VkOverlay" Color="#000000" Opacity="0.45" />
          <SolidColorBrush x:Key="VkDanger" Color="#E64646" />
          <SolidColorBrush x:Key="VkCoverPlaceholder" Color="#E7E8EC" />

          <SolidColorBrush x:Key="TextControlBackground" Color="#F0F2F5" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E9ECF0" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F0F2F5" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#F0F2F5" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#D7DBE0" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2688EB" />
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#F0F2F5" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#000000" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#000000" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#99A2AD" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#818C99" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#99A2AD" />
          <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#2688EB" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

